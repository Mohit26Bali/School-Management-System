generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  name              String
  email             String    @unique
  passwordHash      String
  role              String    @default("admin") // admin | teacher | student
  avatarUrl         String?
  resetTokenHash     String?
  resetTokenExpiry   DateTime?
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  teacher           Teacher?
  student           Student?
}

model Student {
  id                Int      @id @default(autoincrement())
  firstName         String
  lastName          String
  studentId         String   @unique
  gender            String?
  dob               DateTime?
  classId           Int?
  classRef          Class?   @relation(fields: [classId], references: [id])
  religion          String?
  joiningDate       DateTime?
  mobile            String?
  admissionNumber   String?
  imageUrl          String?
  fatherName        String?
  fatherOccupation  String?
  fatherMobile      String?
  fatherEmail       String?
  motherName        String?
  motherOccupation  String?
  motherMobile      String?
  motherEmail       String?
  presentAddress    String?
  permanentAddress  String?
  active            Boolean  @default(true)
  leftOn            DateTime?
  createdAt         DateTime @default(now())

  user              User?    @relation(fields: [userId], references: [id])
  userId            Int?     @unique

  feesCollections   FeesCollection[]
  examResults       ExamResult[]
  attendance        Attendance[]
}

model Teacher {
  id             Int      @id @default(autoincrement())
  teacherId      String   @unique
  name           String
  gender         String?
  dob            DateTime?
  mobile         String?
  joiningDate    DateTime?
  qualification  String?
  experience     String?
  classId          Int?
  classRef         Class?   @relation(fields: [classId], references: [id])
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  imageUrl       String?
  active         Boolean  @default(true)
  leftOn         DateTime?
  createdAt      DateTime @default(now())

  user           User?    @relation(fields: [userId], references: [id])
  userId         Int?     @unique

  salaries       Salary[]
  timeTableEntries TimeTableEntry[]
  attendanceMarked Attendance[]
  teacherSubjects  TeacherSubject[]
}

model Department {
  id                Int       @id @default(autoincrement())
  departmentId      String    @unique
  name              String
  headOfDepartment  String?
  startDate         DateTime?
  createdAt         DateTime  @default(now())
}

model Subject {
  id         Int      @id @default(autoincrement())
  subjectId  String   @unique
  name       String
  createdAt  DateTime @default(now())

  teacherSubjects TeacherSubject[]
  exams           Exam[]
  timeTableEntries TimeTableEntry[]
}

model Fee {
  id         Int       @id @default(autoincrement())
  feesId     String    @unique
  feesType   String
  classId    Int?
  classRef   Class?    @relation(fields: [classId], references: [id])
  amount     Float
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())
}

model FeesCollection {
  id         Int       @id @default(autoincrement())
  feesType   String
  amount     Float
  paidDate   DateTime?
  createdAt  DateTime  @default(now())

  student    Student   @relation(fields: [studentId], references: [id])
  studentId  Int
}

model Expense {
  id                Int       @id @default(autoincrement())
  expensesId        String    @unique
  itemName          String
  itemQuality       String?
  amount            Float
  sourceOfPurchase  String?
  purchaseDate      DateTime?
  purchaseBy        String?
  createdAt         DateTime  @default(now())
}

model Salary {
  id           Int       @id @default(autoincrement())
  amount       Float
  paymentDate  DateTime?
  createdAt    DateTime  @default(now())

  teacher      Teacher   @relation(fields: [teacherId], references: [id])
  teacherId    Int
}

model Exam {
  id         Int       @id @default(autoincrement())
  examName   String
  classId    Int?
  classRef   Class?    @relation(fields: [classId], references: [id])
  subjectId  Int?
  subjectRef Subject?  @relation(fields: [subjectId], references: [id])
  fees       Float?
  startTime  String?
  endTime    String?
  examDate   DateTime?
  maxMarks    Float     @default(100)
  passPercent Float     @default(40)
  createdAt  DateTime  @default(now())

  results    ExamResult[]
}

model ExamResult {
  id             Int      @id @default(autoincrement())
  marksObtained  Float
  maxMarks       Float
  passed         Boolean
  createdAt      DateTime @default(now())

  exam           Exam     @relation(fields: [examId], references: [id])
  examId         Int
  student        Student  @relation(fields: [studentId], references: [id])
  studentId      Int

  @@unique([examId, studentId])
}

model Book {
  id          Int      @id @default(autoincrement())
  bookId      String   @unique
  name        String
  language    String?
  department  String?
  classId     Int?
  classRef    Class?   @relation(fields: [classId], references: [id])
  type        String?
  status      String   @default("In Stock")
  createdAt   DateTime @default(now())
}

model HostelRoom {
  id           Int      @id @default(autoincrement())
  block        String
  roomNo       String
  roomType     String?
  noOfBeds     Int?
  costPerBed   Float?
  availability String   @default("Available")
  createdAt    DateTime @default(now())

  @@unique([block, roomNo])
}

model Transport {
  id             Int      @id @default(autoincrement())
  routeName      String
  vehicleNumber  String   @unique
  driverName     String?
  licenseNumber  String?
  contactNumber  String?
  driverAddress  String?
  createdAt      DateTime @default(now())
}

model Sport {
  id           Int       @id @default(autoincrement())
  sportsId     String    @unique
  name         String
  coachName    String?
  startedYear  DateTime?
  createdAt    DateTime  @default(now())
}

model Holiday {
  id          Int       @id @default(autoincrement())
  holidayId   String    @unique
  name        String
  type        String?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())
}

model Event {
  id         Int       @id @default(autoincrement())
  eventId    String    @unique
  name       String
  eventDate  DateTime?
  createdAt  DateTime  @default(now())
}

model TimeTableEntry {
  id         Int       @id @default(autoincrement())
  classId    Int?
  classRef   Class?    @relation(fields: [classId], references: [id])
  subjectId  Int?
  subjectRef Subject?  @relation(fields: [subjectId], references: [id])
  date       DateTime?
  startTime  String?
  endTime    String?
  createdAt  DateTime  @default(now())

  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  teacherId  Int
}

model Attendance {
  id         Int      @id @default(autoincrement())
  date       DateTime
  status     String
  classId    Int
  classRef   Class    @relation(fields: [classId], references: [id])
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id])
  studentId  Int
  teacher    Teacher  @relation(fields: [teacherId], references: [id])
  teacherId  Int

  @@unique([studentId, date])
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String
  section   String
  createdAt DateTime @default(now())

  students         Student[]
  homeroomTeachers Teacher[]
  teacherSubjects  TeacherSubject[]
  exams            Exam[]
  timeTableEntries TimeTableEntry[]
  attendance       Attendance[]
  fees             Fee[]
  books            Book[]

  @@unique([name, section])
}

model TeacherSubject {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  teacherId Int
  class     Class    @relation(fields: [classId], references: [id])
  classId   Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  subjectId Int

  @@unique([teacherId, classId, subjectId])
}
