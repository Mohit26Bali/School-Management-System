# Copy to .env and fill in. Never commit .env.

# SQLite file, relative to the prisma/ folder
DATABASE_URL="file:./dev.db"

# Required in production (the app refuses to start without it). 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

PORT=3000

# Set to "production" when deployed: secure cookies, and password-reset links are no longer shown on the page
NODE_ENV=development

# Behind a host's proxy (Render, Railway, Nginx): number of proxies in front of the app, so secure cookies and rate limits work
# TRUST_PROXY=1

# Login attempts allowed per IP per 15 minutes (default 10)
# LOGIN_ATTEMPT_LIMIT=10
