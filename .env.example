# Copy to .env and fill in. Never commit .env.

# SQLite file, relative to the prisma/ folder
DATABASE_URL="file:./dev.db"

# Required in production (the app refuses to start without it). 32+ random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

PORT=3000

# Set to "production" when deployed: secure cookies, and password-reset links are no longer shown on the page
NODE_ENV=development

# Behind a host's proxy (Render, Railway, Nginx): number of proxies in front of the app, so secure cookies and rate limits work
# TRUST_PROXY=1

# Login attempts allowed per IP per 15 minutes (default 10)
# LOGIN_ATTEMPT_LIMIT=10

# Days with no school, as numbers (Sunday = 0 ... Saturday = 6). Default "0,6". Attendance cannot be marked on these days.
# WEEKEND_DAYS=0,6

# How many days back a teacher can still mark or correct attendance (default 14)
# ATTENDANCE_EDIT_DAYS=14

# Library: days a book may be kept (14), books one student may have out at once (3), fine per late day (1.00, 0 = no fines)
# LIBRARY_LOAN_DAYS=14
# LIBRARY_MAX_LOANS=3
# LIBRARY_FINE_PER_DAY=1
