<%- include('../partials/head', { title }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row">
<div class="col-sm-12">
<h3 class="page-title">Student Details</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/students">Students</a></li>
<li class="breadcrumb-item active">Student Details</li>
</ul>
</div>
</div>
</div>
<div class="card">
<div class="card-body">
<div class="row">
<div class="col-md-12">
<div class="about-info">
<h4>About</h4>
<div class="media mt-3">
<img src="<%= student.imageUrl || '/img/user.jpg' %>" class="mr-3 rounded-circle" width="80" height="80" alt="<%= student.firstName %>">
<div class="media-body">
<ul>
<li>
<span class="title-span">Full Name : </span>
<span class="info-span"><%= student.firstName %> <%= student.lastName %></span>
</li>
<li>
<span class="title-span">Student ID : </span>
<span class="info-span"><%= student.studentId %></span>
</li>
<li>
<span class="title-span">Class : </span>
<span class="info-span"><%= student.classRef ? student.classRef.name + ' ' + student.classRef.section : '-' %></span>
</li>
<li>
<span class="title-span">Mobile : </span>
<span class="info-span"><%= student.mobile || '-' %></span>
</li>
<li>
<span class="title-span">Gender : </span>
<span class="info-span"><%= student.gender || '-' %></span>
</li>
<li>
<span class="title-span">DOB : </span>
<span class="info-span"><%= student.dob ? student.dob.toDateString() : '-' %></span>
</li>
</ul>
</div>
</div>
<div class="row mt-4">
<div class="col-md-6">
<h5>Parent Information</h5>
<ul>
<li><span class="title-span">Father : </span><span class="info-span"><%= student.fatherName || '-' %> (<%= student.fatherMobile || '-' %>)</span></li>
<li><span class="title-span">Mother : </span><span class="info-span"><%= student.motherName || '-' %> (<%= student.motherMobile || '-' %>)</span></li>
</ul>
</div>
<div class="col-md-6">
<h5>Address</h5>
<ul>
<li><span class="title-span">Present : </span><span class="info-span"><%= student.presentAddress || '-' %></span></li>
<li><span class="title-span">Permanent : </span><span class="info-span"><%= student.permanentAddress || '-' %></span></li>
</ul>
</div>
</div>
<div class="row mt-3">
<div class="col-12">
<a href="/students/<%= student.id %>/edit" class="btn btn-primary"><i class="fas fa-pen"></i> Edit</a>
<a href="/students" class="btn btn-outline-primary">Back to list</a>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
