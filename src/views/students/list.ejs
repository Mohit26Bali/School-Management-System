<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Students</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Students</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/students/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Student</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>Student ID</th>
<th>Name</th>
<th>Class</th>
<th>DOB</th>
<th>Parent Name</th>
<th>Mobile Number</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (students.length === 0) { %>
<tr><td colspan="7" class="text-center text-muted">No students yet. <a href="/students/add">Add the first one</a>.</td></tr>
<% } %>
<% students.forEach(function(student) { %>
<tr>
<td><%= student.studentId %></td>
<td>
<h2 class="table-avatar">
<a href="/students/<%= student.id %>" class="avatar avatar-sm mr-2"><img class="avatar-img rounded-circle" src="<%= student.imageUrl || '/img/user.jpg' %>" alt="User Image"></a>
<a href="/students/<%= student.id %>"><%= student.firstName %> <%= student.lastName %></a>
</h2>
</td>
<td><%= student.classRef ? student.classRef.name + ' ' + student.classRef.section : '-' %></td>
<td><%= student.dob ? student.dob.toDateString() : '-' %></td>
<td><%= student.fatherName || '-' %></td>
<td><%= student.mobile || '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/students/<%= student.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/students/<%= student.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this student?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
