<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Students</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Students</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/students/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Student</a>
</div>
</div>
</div>
<%- include('../partials/flash') %>
<% if (typeof notice !== 'undefined' && notice) { %>
<div class="alert alert-success"><%= notice %></div>
<% } %>
<ul class="nav nav-pills mb-3">
<li class="nav-item"><a class="nav-link <%= show === 'active' ? 'active' : '' %>" href="/students">Active</a></li>
<li class="nav-item"><a class="nav-link <%= show === 'inactive' ? 'active' : '' %>" href="/students?show=inactive">Inactive</a></li>
<li class="nav-item"><a class="nav-link <%= show === 'all' ? 'active' : '' %>" href="/students?show=all">All</a></li>
</ul>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>Student ID</th>
<th>Name</th>
<th>Class</th>
<th>DOB</th>
<th>Parent Name</th>
<th>Mobile Number</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (students.length === 0) { %>
<tr><td colspan="7" class="text-center text-muted">No students yet. <a href="/students/add">Add the first one</a>.</td></tr>
<% } %>
<% students.forEach(function(student) { %>
<tr>
<td><%= student.studentId %></td>
<td>
<h2 class="table-avatar">
<a href="/students/<%= student.id %>" class="avatar avatar-sm mr-2"><img class="avatar-img rounded-circle" src="<%= student.imageUrl || '/img/user.jpg' %>" alt="User Image"></a>
<a href="/students/<%= student.id %>"><%= student.firstName %> <%= student.lastName %></a>
</h2>
</td>
<td><%= student.classRef ? student.classRef.name + ' ' + student.classRef.section : '-' %></td>
<td><%= student.dob ? student.dob.toDateString() : '-' %></td>
<td><%= student.fatherName || '-' %></td>
<td><%= student.mobile || '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/students/<%= student.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<% if (student.active) { %>
<form method="POST" action="/students/<%= student.id %>/delete" class="d-inline" onsubmit="return confirm('Remove this student? If they have attendance, results or payments on record they are marked inactive instead of deleted.');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light" title="Remove or mark inactive" aria-label="Remove or mark inactive">
<i class="fas fa-trash"></i>
</button>
</form>
<% } else { %>
<form method="POST" action="/students/<%= student.id %>/reactivate" class="d-inline" onsubmit="return confirm('Reactivate this student?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-info-light" title="Reactivate" aria-label="Reactivate">
<i class="fas fa-undo"></i>
</button>
</form>
<% } %>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
