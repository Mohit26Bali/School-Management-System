<%- include('../partials/head', { title }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Assign a Route</h3>
<ul class="breadcrumb"><li class="breadcrumb-item"><a href="/transport/riders">Riders</a></li><li class="breadcrumb-item active">Assign</li></ul>
</div>

</div>
</div>
<%- include('../partials/flash') %>
<div class="card"><div class="card-body">
<% if (typeof error !== 'undefined' && error) { %><div class="alert alert-danger"><%= error %></div><% } %>
<form method="POST" action="/transport/riders">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row">
<div class="col-12 col-sm-6"><div class="form-group"><label>Route</label>
<select name="routeId" class="form-control" required>
<option value="">Select route</option>
<% routes.forEach(function(r) { %><option value="<%= r.id %>" <%= typeof values !== 'undefined' && String(values.routeId) === String(r.id) ? 'selected' : '' %> <%= r.seats && r.free < 1 ? 'disabled' : '' %>><%= r.routeName %> (<%= r.vehicleNumber %>)<%= r.seats ? ', ' + r.free + ' of ' + r.seats + ' seats free' : '' %></option><% }) %>
</select></div></div>
<div class="col-12 col-sm-6"><div class="form-group"><label>Student ID</label>
<input type="text" name="studentId" class="form-control" value="<%= typeof values !== 'undefined' && typeof values.studentId === 'string' ? values.studentId : '' %>" placeholder="e.g. PRE2209" required></div></div>
<div class="col-12"><button type="submit" class="btn btn-primary">Assign</button></div>
</div>
</form></div></div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
