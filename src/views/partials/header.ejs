<div class="header">
   <div class="header-left">
      <a href="/" class="logo">
      <img src="/img/logo.png" alt="Logo">
      </a>
      <a href="/" class="logo logo-small">
      <img src="/img/logo-small.png" alt="Logo" width="30" height="30">
      </a>
   </div>
   <a href="javascript:void(0);" id="toggle_btn">
   <i class="fas fa-align-left"></i>
   </a>
   <% if (user.role === 'admin') { %>
   <div class="top-nav-search">
      <form method="GET" action="/search">
         <input type="text" name="q" class="form-control" placeholder="Search students, teachers...">
         <button class="btn" type="submit"><i class="fas fa-search"></i></button>
      </form>
   </div>
   <% } %>
   <a class="mobile_btn" id="mobile_btn">
   <i class="fas fa-bars"></i>
   </a>
   <ul class="nav user-menu">
      <li class="nav-item">
         <a href="javascript:void(0);" id="theme_toggle" class="nav-link" title="Toggle dark mode">
         <i class="fas fa-moon"></i>
         </a>
      </li>
      <li class="nav-item dropdown noti-dropdown">
         <a href="#" class="dropdown-toggle nav-link" data-toggle="dropdown">
         <i class="far fa-bell"></i>
         <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
         <span class="badge badge-pill"><%= notifications.length %></span>
         <% } %>
         </a>
         <div class="dropdown-menu notifications">
            <div class="topnav-dropdown-header">
               <span class="notification-title">Notifications</span>
            </div>
            <div class="noti-content">
               <% if (typeof notifications === 'undefined' || notifications.length === 0) { %>
               <p class="text-center text-muted mb-0 p-3">No new notifications</p>
               <% } else { %>
               <ul class="notification-list">
               <% notifications.forEach(function(n) { %>
                  <li class="notification-message">
                     <a href="#">
                        <div class="media">
                           <div class="media-body">
                              <p class="noti-details"><span class="noti-title"><%= n.text %></span> <%= n.detail %></p>
                              <p class="noti-time"><span class="notification-time"><%= n.date ? n.date.toDateString() : '' %></span></p>
                           </div>
                        </div>
                     </a>
                  </li>
               <% }) %>
               </ul>
               <% } %>
            </div>
         </div>
      </li>
      <li class="nav-item dropdown has-arrow">
         <a href="#" class="dropdown-toggle nav-link" data-toggle="dropdown">
         <span class="user-img"><img class="rounded-circle" src="<%= user.avatarUrl || '/img/user.jpg' %>" width="31" alt="<%= user.name %>"></span>
         </a>
         <div class="dropdown-menu">
            <div class="user-header">
               <div class="avatar avatar-sm">
                  <img src="<%= user.avatarUrl || '/img/user.jpg' %>" alt="User Image" class="avatar-img rounded-circle">
               </div>
               <div class="user-text">
                  <h6><%= user.name %></h6>
                  <p class="text-muted mb-0"><%= user.role %></p>
               </div>
            </div>
            <a class="dropdown-item" href="/profile">My Profile</a>
            <a class="dropdown-item" href="/logout">Logout</a>
         </div>
      </li>
   </ul>
</div>
<script>
(function () {
  var btn = document.getElementById('theme_toggle');
  var icon = btn.querySelector('i');
  function sync() {
    var isDark = document.documentElement.classList.contains('dark-mode');
    icon.className = isDark ? 'fas fa-sun' : 'fas fa-moon';
  }
  sync();
  btn.addEventListener('click', function () {
    document.documentElement.classList.toggle('dark-mode');
    var isDark = document.documentElement.classList.contains('dark-mode');
    document.cookie = 'theme=' + (isDark ? 'dark' : 'light') + '; path=/; max-age=31536000';
    sync();
  });
})();
</script>
