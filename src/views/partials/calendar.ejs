<style>
.mini-calendar { width: 100%; }
.mini-calendar table { width: 100%; border-collapse: collapse; text-align: center; }
.mini-calendar th { font-size: .72rem; text-transform: uppercase; color: #9e9e9e; padding: 4px 0; font-weight: 600; }
.mini-calendar td { padding: 6px 0; position: relative; }
.mini-calendar .day-num { display: inline-flex; align-items: center; justify-content: center; width: 30px; height: 30px; border-radius: 50%; font-size: .85rem; }
.mini-calendar .today .day-num { background: #FF6B5E; color: #fff; font-weight: 600; }
.mini-calendar .has-holiday .day-num { box-shadow: 0 0 0 2px #f6c23e inset; }
.mini-calendar .has-event .day-num { box-shadow: 0 0 0 2px #4e73df inset; }
</style>
<div class="mini-calendar">
<h6 class="text-center mb-2"><%= calendar.monthLabel %></h6>
<table>
<thead>
<tr><th>Su</th><th>Mo</th><th>Tu</th><th>We</th><th>Th</th><th>Fr</th><th>Sa</th></tr>
</thead>
<tbody>
<% calendar.weeks.forEach(function(week) { %>
<tr>
<% week.forEach(function(cell) { %>
<% if (!cell) { %>
<td></td>
<% } else { %>
<td class="<%= cell.isToday ? 'today' : '' %> <%= cell.highlights.some(h => h.type === 'holiday') ? 'has-holiday' : '' %> <%= cell.highlights.some(h => h.type === 'event') ? 'has-event' : '' %>" title="<%= cell.highlights.map(h => h.label).join(', ') %>">
<span class="day-num"><%= cell.day %></span>
</td>
<% } %>
<% }) %>
</tr>
<% }) %>
</tbody>
</table>
<div class="mt-2 small text-muted">
<span class="mr-2"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;box-shadow:0 0 0 2px #f6c23e inset;"></span> Holiday</span>
<span><span style="display:inline-block;width:10px;height:10px;border-radius:50%;box-shadow:0 0 0 2px #4e73df inset;"></span> Event</span>
</div>
</div>
