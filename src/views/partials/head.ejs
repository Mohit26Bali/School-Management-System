<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="utf-8">
   <script>(function(){var m=document.cookie.match(/(?:^|; )theme=(dark|light)/);if(m&&m[1]==='dark')document.documentElement.classList.add('dark-mode');})();</script>
   <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
   <title>School Management<%= typeof title !== 'undefined' ? ' - ' + title : '' %></title>
   <link rel="shortcut icon" href="/img/favicon.png">
   <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,500;0,600;0,700;1,400&amp;display=swap">
   <link rel="stylesheet" href="/vendor/bootstrap/css/bootstrap.min.css">
   <link rel="stylesheet" href="/vendor/fontawesome/css/fontawesome.min.css">
   <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
   <% if (typeof extraCss !== 'undefined') { extraCss.forEach(function(href) { %>
   <link rel="stylesheet" href="<%= href %>">
   <% }) } %>
   <link rel="stylesheet" href="/css/style.css">
   <link rel="stylesheet" href="/css/dark-mode.css">
</head>
