<%- include('../partials/head', { title }) %>
<body class="auth-bg">
<div class="main-wrapper login-body">
<div class="login-wrapper">
<div class="container">
<div class="loginbox">
<div class="login-left">
<img class="img-fluid" src="/img/logo-white.png" alt="Logo">
<h4 class="login-left-heading">School Management Simplified</h4>
<p class="login-left-caption">Manage students, teachers, attendance, grades, and communication from one intuitive dashboard.</p>
<ul class="login-left-features">
<li><i class="fas fa-check-circle"></i> Student Management</li>
<li><i class="fas fa-check-circle"></i> Attendance Tracking</li>
<li><i class="fas fa-check-circle"></i> Grade Management</li>
</ul>
</div>
<div class="login-right">
<div class="login-right-wrap">
<h1>Reset Password</h1>
<p class="account-subtitle">Choose a new password</p>

<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (typeof errors !== 'undefined' && errors.length) { %>
<div class="alert alert-danger">
  <ul class="mb-0">
  <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
  </ul>
</div>
<% } %>

<form method="POST" action="/reset-password/<%= token %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="form-group">
<i class="fas fa-lock input-icon"></i>
<input class="form-control" type="password" name="password" placeholder="New Password" required minlength="8">
</div>
<div class="form-group mb-0">
<i class="fas fa-lock input-icon"></i>
<input class="form-control" type="password" name="confirmPassword" placeholder="Confirm New Password" required minlength="8">
</div>
<div class="form-group">
<button class="btn btn-primary btn-block" type="submit">Reset Password</button>
</div>
</form>
<div class="text-center dont-have">Remember your password? <a href="/login">Login</a></div>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
