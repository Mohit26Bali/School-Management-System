<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Library</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Library</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/library/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Book</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Language</th>
<th>Department</th>
<th>Class</th>
<th>Type</th>
<th>Status</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (books.length === 0) { %>
<tr><td colspan="8" class="text-center text-muted">No books yet. <a href="/library/add">Add the first one</a>.</td></tr>
<% } %>
<% books.forEach(function(book) { %>
<tr>
<td><%= book.bookId %></td>
<td><%= book.name %></td>
<td><%= book.language || '-' %></td>
<td><%= book.department || '-' %></td>
<td><%= book.classRef ? book.classRef.name : '-' %></td>
<td><%= book.type || '-' %></td>
<td><span class="badge <%= book.status === 'In Stock' ? 'badge-success' : 'badge-danger' %>"><%= book.status %></span></td>
<td class="text-right">
<div class="actions">
<a href="/library/<%= book.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/library/<%= book.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this book?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
