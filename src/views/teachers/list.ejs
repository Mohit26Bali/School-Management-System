<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Teachers</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Teachers</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/teachers/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Teacher</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>Teacher ID</th>
<th>Name</th>
<th>Class</th>
<th>Gender</th>
<th>Subject</th>
<th>Section</th>
<th>Mobile Number</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (teachers.length === 0) { %>
<tr><td colspan="8" class="text-center text-muted">No teachers yet. <a href="/teachers/add">Add the first one</a>.</td></tr>
<% } %>
<% teachers.forEach(function(teacher) { %>
<tr>
<td><%= teacher.teacherId %></td>
<td>
<h2 class="table-avatar">
<a href="/teachers/<%= teacher.id %>" class="avatar avatar-sm mr-2"><img class="avatar-img rounded-circle" src="<%= teacher.imageUrl || '/img/user.jpg' %>" alt="User Image"></a>
<a href="/teachers/<%= teacher.id %>"><%= teacher.name %></a>
</h2>
</td>
<td><%= teacher.classRef ? teacher.classRef.name : '-' %></td>
<td><%= teacher.gender || '-' %></td>
<td><%= teacher.teacherSubjects.length ? teacher.teacherSubjects.map(function(ts){ return ts.subject.name; }).join(', ') : '-' %></td>
<td><%= teacher.classRef ? teacher.classRef.section : '-' %></td>
<td><%= teacher.mobile || '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/teachers/<%= teacher.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/teachers/<%= teacher.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this teacher?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
