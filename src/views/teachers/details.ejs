<%- include('../partials/head', { title }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row">
<div class="col-sm-12">
<h3 class="page-title">Teacher Details</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/teachers">Teachers</a></li>
<li class="breadcrumb-item active">Teacher Details</li>
</ul>
</div>
</div>
</div>
<div class="card">
<div class="card-body">
<div class="row">
<div class="col-md-12">
<div class="about-info">
<h4>About</h4>
<div class="media mt-3">
<img src="<%= teacher.imageUrl || '/img/user.jpg' %>" class="mr-3 rounded-circle" width="80" height="80" alt="<%= teacher.name %>">
<div class="media-body">
<ul>
<li>
<span class="title-span">Full Name : </span>
<span class="info-span"><%= teacher.name %></span>
</li>
<li>
<span class="title-span">Teacher ID : </span>
<span class="info-span"><%= teacher.teacherId %></span>
</li>
<li>
<span class="title-span">Subjects : </span>
<span class="info-span"><%= teacher.teacherSubjects.length ? teacher.teacherSubjects.map(function(ts){ return ts.subject.name; }).join(', ') : '-' %></span>
</li>
<li>
<span class="title-span">Class : </span>
<span class="info-span"><%= teacher.classRef ? teacher.classRef.name + ' ' + teacher.classRef.section : '-' %></span>
</li>
<li>
<span class="title-span">Mobile : </span>
<span class="info-span"><%= teacher.mobile || '-' %></span>
</li>
<li>
<span class="title-span">Gender : </span>
<span class="info-span"><%= teacher.gender || '-' %></span>
</li>
<li>
<span class="title-span">DOB : </span>
<span class="info-span"><%= teacher.dob ? teacher.dob.toDateString() : '-' %></span>
</li>
<li>
<span class="title-span">Qualification : </span>
<span class="info-span"><%= teacher.qualification || '-' %></span>
</li>
<li>
<span class="title-span">Experience : </span>
<span class="info-span"><%= teacher.experience || '-' %></span>
</li>
</ul>
</div>
</div>
<div class="row mt-4">
<div class="col-md-12">
<h5>Address</h5>
<p><%= [teacher.address, teacher.city, teacher.state, teacher.zipCode, teacher.country].filter(Boolean).join(', ') || '-' %></p>
</div>
</div>
<div class="row mt-3">
<div class="col-12">
<%- include('../partials/portal-login', { person: teacher, portalUser: portalUser, base: '/teachers' }) %>
</div>
</div>
<div class="row mt-3">
<div class="col-12">
<a href="/teachers/<%= teacher.id %>/edit" class="btn btn-primary"><i class="fas fa-pen"></i> Edit</a>
<a href="/teachers" class="btn btn-outline-primary">Back to list</a>
</div>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
