<%
// Expects: formAction, teacher (object, may have empty/null fields), error, classes, subjects
const t = typeof teacher !== 'undefined' ? teacher : {};
function val(v) { return v === null || v === undefined ? '' : v; }
const selectedSubjectIds = (t.teacherSubjects || []).map(ts => ts.subjectId);
%>
<div class="row">
<div class="col-sm-12">
<div class="card">
<div class="card-body">
<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><%= error %></div>
<% } %>
<form method="POST" action="<%= formAction %>" enctype="multipart/form-data">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row">
<div class="col-12">
<h5 class="form-title"><span>Basic Details</span></h5>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Teacher ID</label>
<input type="text" name="teacherId" class="form-control" value="<%= val(t.teacherId) %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Name</label>
<input type="text" name="name" class="form-control" value="<%= val(t.name) %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Gender</label>
<select name="gender" class="form-control select">
<option value="" <%= !t.gender ? 'selected' : '' %>>Select Gender</option>
<option <%= t.gender === 'Male' ? 'selected' : '' %>>Male</option>
<option <%= t.gender === 'Female' ? 'selected' : '' %>>Female</option>
<option <%= t.gender === 'Others' ? 'selected' : '' %>>Others</option>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Date of Birth</label>
<input type="text" name="dob" class="form-control datetimepicker" value="<%= t.dob ? new Date(t.dob).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Mobile</label>
<input type="text" name="mobile" class="form-control phone-input" value="<%= val(t.mobile) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Joining Date</label>
<input type="text" name="joiningDate" class="form-control datetimepicker" value="<%= t.joiningDate ? new Date(t.joiningDate).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Qualification</label>
<input type="text" name="qualification" class="form-control" value="<%= val(t.qualification) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Experience</label>
<input type="text" name="experience" class="form-control" value="<%= val(t.experience) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Homeroom Class</label>
<select name="classId" class="form-control select">
<option value="" <%= !t.classId ? 'selected' : '' %>>Select Class</option>
<% classes.forEach(function(c) { %>
<option value="<%= c.id %>" <%= Number(t.classId) === c.id ? 'selected' : '' %>><%= c.name %> - <%= c.section %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Subjects Taught</label>
<select name="subjectIds" class="form-control select" multiple>
<% subjects.forEach(function(sub) { %>
<option value="<%= sub.id %>" <%= selectedSubjectIds.includes(sub.id) ? 'selected' : '' %>><%= sub.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Teacher Image</label>
<input type="file" name="image" class="form-control" accept="image/png,image/jpeg,image/webp">
</div>
</div>
<% if (typeof isNew === 'undefined' || isNew) { %>
<div class="col-12">
<h5 class="form-title"><span>Portal Login (optional)</span></h5>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Email</label>
<input type="email" name="email" class="form-control" placeholder="Leave blank for no portal access">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Password</label>
<input type="password" name="password" class="form-control" minlength="8">
</div>
</div>
<% } %>
<div class="col-12">
<h5 class="form-title"><span>Address</span></h5>
</div>
<div class="col-12">
<div class="form-group">
<label>Address</label>
<input type="text" name="address" class="form-control" value="<%= val(t.address) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>City</label>
<input type="text" name="city" class="form-control" value="<%= val(t.city) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>State</label>
<input type="text" name="state" class="form-control" value="<%= val(t.state) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Zip Code</label>
<input type="text" name="zipCode" class="form-control" value="<%= val(t.zipCode) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Country</label>
<input type="text" name="country" class="form-control" value="<%= val(t.country) %>">
</div>
</div>
<div class="col-12">
<button type="submit" class="btn btn-primary">Submit</button>
</div>
</div>
</form>
</div>
</div>
</div>
</div>
