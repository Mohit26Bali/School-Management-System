<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Fees</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Fees</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/fees/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Fees</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Fees Name</th>
<th>Class</th>
<th>Amount</th>
<th>Start Date</th>
<th>End Date</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (fees.length === 0) { %>
<tr><td colspan="7" class="text-center text-muted">No fee types yet. <a href="/fees/add">Add the first one</a>.</td></tr>
<% } %>
<% fees.forEach(function(fee) { %>
<tr>
<td><%= fee.feesId %></td>
<td><%= fee.feesType %></td>
<td><%= fee.classRef ? fee.classRef.name : '-' %></td>
<td><%= fee.amount.toFixed(2) %></td>
<td><%= fee.startDate ? fee.startDate.toDateString() : '-' %></td>
<td><%= fee.endDate ? fee.endDate.toDateString() : '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/fees/<%= fee.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/fees/<%= fee.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this fee type?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
