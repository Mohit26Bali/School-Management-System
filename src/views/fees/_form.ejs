<%
const f = typeof fee !== 'undefined' ? fee : {};
function val(v) { return v === null || v === undefined ? '' : v; }
%>
<div class="row">
<div class="col-sm-12">
<div class="card">
<div class="card-body">
<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><%= error %></div>
<% } %>
<form method="POST" action="<%= formAction %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row">
<div class="col-12">
<h5 class="form-title"><span>Fees Information</span></h5>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Fees ID</label>
<input type="text" name="feesId" class="form-control" value="<%= val(f.feesId) %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Fees Type</label>
<select name="feesType" class="form-control select" required>
<option value="" <%= !f.feesType ? 'selected' : '' %>>Select Type</option>
<% feesTypes.forEach(function(type) { %>
<option <%= f.feesType === type ? 'selected' : '' %>><%= type %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Class</label>
<select name="classId" class="form-control select">
<option value="" <%= !f.classId ? 'selected' : '' %>>Select Class</option>
<% classes.forEach(function(c) { %>
<option value="<%= c.id %>" <%= Number(f.classId) === c.id ? 'selected' : '' %>><%= c.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Fees Amount</label>
<input type="number" step="0.01" min="0" name="amount" class="form-control" value="<%= val(f.amount) %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Start Date</label>
<input type="text" name="startDate" class="form-control datetimepicker" value="<%= f.startDate ? new Date(f.startDate).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>End Date</label>
<input type="text" name="endDate" class="form-control datetimepicker" value="<%= f.endDate ? new Date(f.endDate).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12">
<button type="submit" class="btn btn-primary">Submit</button>
</div>
</div>
</form>
</div>
</div>
</div>
</div>
