<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css', '/css/bootstrap-datetimepicker.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Attendance</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Attendance</li>
</ul>
</div>
</div>
</div>

<div class="card">
<div class="card-body">
<form method="GET" action="/attendance" class="form-inline mb-3">
<label class="mr-2">Date</label>
<input type="text" name="date" class="form-control datetimepicker mr-3" value="<%= dateStr %>">
<label class="mr-2">Class</label>
<select name="classId" class="form-control mr-3">
<option value="">All Classes</option>
<% classes.forEach(function(c) { %>
<option value="<%= c.id %>" <%= classFilter === c.id ? 'selected' : '' %>><%= c.name %> - <%= c.section %></option>
<% }) %>
</select>
<button type="submit" class="btn btn-outline-primary">Filter</button>
</form>

<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>Student ID</th>
<th>Name</th>
<th>Class</th>
<th>Status</th>
<th>Marked By</th>
</tr>
</thead>
<tbody>
<% if (records.length === 0) { %>
<tr><td colspan="5" class="text-center text-muted">No attendance records for this date/class.</td></tr>
<% } %>
<% records.forEach(function(r) { %>
<tr>
<td><%= r.student.studentId %></td>
<td><%= r.student.firstName %> <%= r.student.lastName %></td>
<td><%= r.classRef ? r.classRef.name + ' ' + r.classRef.section : '-' %></td>
<td><span class="badge <%= r.status === 'Present' ? 'badge-success' : r.status === 'Late' ? 'badge-warning' : 'badge-danger' %>"><%= r.status %></span></td>
<td><%= r.teacher.name %></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>

</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js', '/js/moment.min.js', '/js/bootstrap-datetimepicker.min.js'] }) %>
</body>
</html>
