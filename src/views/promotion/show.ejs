<%- include('../partials/head', { title }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Promote Students</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Promotion</li>
</ul>
</div>
</div>
</div>
<%- include('../partials/flash') %>
<div class="card">
<div class="card-body">
<form method="GET" action="/promotion" class="form-inline mb-3">
<label class="mr-2">Move students out of</label>
<select name="from" class="form-control mr-2" onchange="this.form.submit()">
<option value="">Select class</option>
<% classes.forEach(function(c) { %><option value="<%= c.id %>" <%= source && source.id === c.id ? 'selected' : '' %>><%= c.name %> <%= c.section %> (<%= c.enrolled %> students)</option><% }) %>
</select>
<noscript><button type="submit" class="btn btn-outline-primary">Load</button></noscript>
</form>
<% if (source) { %>
<% if (students.length === 0) { %>
<p class="text-muted mb-0">There are no active students in <%= source.name %> <%= source.section %>.</p>
<% } else { %>
<form method="POST" action="/promotion">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<input type="hidden" name="fromId" value="<%= source.id %>">
<div class="table-responsive">
<table class="table table-hover table-center mb-3">
<thead><tr><th style="width:50px"><input type="checkbox" checked id="pickAll" aria-label="Select all"></th><th>Student ID</th><th>Name</th><th>Books out</th></tr></thead>
<tbody>
<% students.forEach(function(s) { %>
<tr>
<td><input type="checkbox" class="pick" name="studentIds" value="<%= s.id %>" checked aria-label="Move <%= s.firstName %> <%= s.lastName %>"></td>
<td><%= s.studentId %></td>
<td><%= s.firstName %> <%= s.lastName %></td>
<td><%= s._count.loans || '-' %></td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<div class="form-inline">
<label class="mr-2">Move the ticked students to</label>
<select name="target" class="form-control mr-2" required>
<option value="">Select destination</option>
<% classes.forEach(function(c) { if (c.id !== source.id) { %><option value="<%= c.id %>"><%= c.name %> <%= c.section %> (<%= c.free %> places free)</option><% } }) %>
<option value="graduate">Graduate (they leave school)</option>
</select>
<button type="submit" class="btn btn-primary" onclick="return confirm('Move the ticked students?');">Move</button>
</div>
<p class="text-muted small mt-2 mb-0">Graduating makes them inactive: their login stops, and their hostel room and transport route end. Their records are kept. Students who still have library books out cannot graduate.</p>
</form>
<% } %>
<% } %>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
<script>
(function () {
  var all = document.getElementById('pickAll');
  if (!all) return;
  all.addEventListener('change', function () {
    document.querySelectorAll('.pick').forEach(function (b) { b.checked = all.checked; });
  });
})();
</script>
</body>
</html>
