<%
const e = typeof entry !== 'undefined' ? entry : {};
const t = e.teacher || {};
function val(v) { return v === null || v === undefined ? '' : v; }
%>
<div class="row">
<div class="col-sm-12">
<div class="card">
<div class="card-body">
<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><%= error %></div>
<% } %>
<form method="POST" action="<%= formAction %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row">
<div class="col-12">
<h5 class="form-title"><span>Time Table</span></h5>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Teacher Id</label>
<input type="text" name="teacherId" class="form-control" value="<%= val(t.teacherId) %>" placeholder="e.g. TCH1001" required>
<small class="form-text text-muted">Must match an existing teacher's Teacher ID.</small>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Class</label>
<select name="classId" class="form-control select">
<option value="" <%= !e.classId ? 'selected' : '' %>>Select Class</option>
<% classes.forEach(function(c) { %>
<option value="<%= c.id %>" <%= Number(e.classId) === c.id ? 'selected' : '' %>><%= c.name %> - <%= c.section %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Subject</label>
<select name="subjectId" class="form-control select">
<option value="" <%= !e.subjectId ? 'selected' : '' %>>Select Subject</option>
<% subjects.forEach(function(sub) { %>
<option value="<%= sub.id %>" <%= Number(e.subjectId) === sub.id ? 'selected' : '' %>><%= sub.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Date</label>
<input type="text" name="date" class="form-control datetimepicker" value="<%= e.date ? new Date(e.date).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Start Time</label>
<input type="time" name="startTime" class="form-control" value="<%= val(e.startTime) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>End Time</label>
<input type="time" name="endTime" class="form-control" value="<%= val(e.endTime) %>">
</div>
</div>
<div class="col-12">
<button type="submit" class="btn btn-primary">Submit</button>
</div>
</div>
</form>
</div>
</div>
</div>
</div>
