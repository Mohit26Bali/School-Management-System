<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Time Table</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Time Table</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/time-table/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Entry</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Class</th>
<th>Subject</th>
<th>Start Time</th>
<th>End Time</th>
<th>Date</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (entries.length === 0) { %>
<tr><td colspan="8" class="text-center text-muted">No entries yet. <a href="/time-table/add">Add the first one</a>.</td></tr>
<% } %>
<% entries.forEach(function(entry) { %>
<tr>
<td><%= entry.teacher.teacherId %></td>
<td><a href="/teachers/<%= entry.teacher.id %>"><%= entry.teacher.name %></a></td>
<td><%= entry.classRef ? entry.classRef.name + ' ' + entry.classRef.section : '-' %></td>
<td><%= entry.subjectRef ? entry.subjectRef.name : '-' %></td>
<td><%= entry.startTime || '-' %></td>
<td><%= entry.endTime || '-' %></td>
<td><%= entry.date ? entry.date.toDateString() : '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/time-table/<%= entry.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/time-table/<%= entry.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this entry?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
