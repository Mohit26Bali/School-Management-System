<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Exam</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Exam</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/exam/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Exam</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<% if (typeof notice !== 'undefined' && notice) { %>
<div class="alert alert-warning"><%= notice %></div>
<% } %>
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>Exam Name</th>
<th>Class</th>
<th>Subject</th>
<th>Start Time</th>
<th>End Time</th>
<th>Date</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (exams.length === 0) { %>
<tr><td colspan="7" class="text-center text-muted">No exams yet. <a href="/exam/add">Add the first one</a>.</td></tr>
<% } %>
<% exams.forEach(function(exam) { %>
<tr>
<td><%= exam.examName %></td>
<td><%= exam.classRef ? exam.classRef.name : '-' %></td>
<td><%= exam.subjectRef ? exam.subjectRef.name : '-' %></td>
<td><%= exam.startTime || '-' %></td>
<td><%= exam.endTime || '-' %></td>
<td><%= exam.examDate ? exam.examDate.toDateString() : '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/exam-results/<%= exam.id %>" class="btn btn-sm bg-info-light mr-2" title="Enter results"><i class="fas fa-clipboard-check"></i></a>
<a href="/exam/<%= exam.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/exam/<%= exam.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this exam?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
