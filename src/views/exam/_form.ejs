<%
const e = typeof exam !== 'undefined' ? exam : {};
function val(v) { return v === null || v === undefined ? '' : v; }
%>
<div class="row">
<div class="col-sm-12">
<div class="card">
<div class="card-body">
<% if (typeof error !== 'undefined' && error) { %>
<div class="alert alert-danger"><%= error %></div>
<% } %>
<form method="POST" action="<%= formAction %>">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<div class="row">
<div class="col-12">
<h5 class="form-title"><span>Exam Information</span></h5>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Exam Name</label>
<input type="text" name="examName" class="form-control" value="<%= val(e.examName) %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Class</label>
<select name="classId" class="form-control select">
<option value="" <%= !e.classId ? 'selected' : '' %>>Select Class</option>
<% classes.forEach(function(c) { %>
<option value="<%= c.id %>" <%= Number(e.classId) === c.id ? 'selected' : '' %>><%= c.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Subject</label>
<select name="subjectId" class="form-control select">
<option value="" <%= !e.subjectId ? 'selected' : '' %>>Select Subject</option>
<% subjects.forEach(function(sub) { %>
<option value="<%= sub.id %>" <%= Number(e.subjectId) === sub.id ? 'selected' : '' %>><%= sub.name %></option>
<% }) %>
</select>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Fees</label>
<input type="number" step="0.01" min="0" name="fees" class="form-control" value="<%= val(e.fees) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Start Time</label>
<input type="time" name="startTime" class="form-control" value="<%= val(e.startTime) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>End Time</label>
<input type="time" name="endTime" class="form-control" value="<%= val(e.endTime) %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Event Date</label>
<input type="text" name="examDate" class="form-control datetimepicker" value="<%= e.examDate ? new Date(e.examDate).toISOString().slice(0,10) : '' %>">
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Maximum marks</label>
<input type="number" step="0.01" min="1" max="1000" name="maxMarks" class="form-control" value="<%= e.maxMarks === undefined || e.maxMarks === null ? 100 : e.maxMarks %>" required>
</div>
</div>
<div class="col-12 col-sm-6">
<div class="form-group">
<label>Pass mark (% of maximum)</label>
<input type="number" step="0.01" min="0" max="100" name="passPercent" class="form-control" value="<%= e.passPercent === undefined || e.passPercent === null ? 40 : e.passPercent %>" required>
</div>
</div>
<div class="col-12">
<button type="submit" class="btn btn-primary">Submit</button>
</div>
</div>
</form>
</div>
</div>
</div>
</div>
