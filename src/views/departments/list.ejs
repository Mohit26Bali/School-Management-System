<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Departments</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Departments</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/departments/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Department</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>HOD</th>
<th>Started</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (departments.length === 0) { %>
<tr><td colspan="5" class="text-center text-muted">No departments yet. <a href="/departments/add">Add the first one</a>.</td></tr>
<% } %>
<% departments.forEach(function(department) { %>
<tr>
<td><%= department.departmentId %></td>
<td><%= department.name %></td>
<td><%= department.headOfDepartment || '-' %></td>
<td><%= department.startDate ? department.startDate.toDateString() : '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/departments/<%= department.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/departments/<%= department.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this department?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
