<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Expenses</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Expenses</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/expenses/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Expense</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Item Name</th>
<th>Item Quality</th>
<th>Amount</th>
<th>Purchase Source</th>
<th>Purchase Date</th>
<th>Purchase By</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (expenses.length === 0) { %>
<tr><td colspan="8" class="text-center text-muted">No expenses yet. <a href="/expenses/add">Add the first one</a>.</td></tr>
<% } %>
<% expenses.forEach(function(expense) { %>
<tr>
<td><%= expense.expensesId %></td>
<td><%= expense.itemName %></td>
<td><%= expense.itemQuality || '-' %></td>
<td><%= expense.amount.toFixed(2) %></td>
<td><%= expense.sourceOfPurchase || '-' %></td>
<td><%= expense.purchaseDate ? expense.purchaseDate.toDateString() : '-' %></td>
<td><%= expense.purchaseBy || '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/expenses/<%= expense.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/expenses/<%= expense.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this expense?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
