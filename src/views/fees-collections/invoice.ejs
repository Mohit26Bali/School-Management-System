<%- include('../partials/head', { title }) %>
<style>
.invoice-box { max-width: 800px; margin: 0 auto; }
.invoice-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 30px; }
.invoice-header img { height: 40px; }
.invoice-title { text-align: right; }
.invoice-title h2 { margin: 0; }
.invoice-meta { color: #6c757d; }
.invoice-parties { display: flex; justify-content: space-between; margin-bottom: 30px; }
.invoice-total-row td { font-weight: 700; font-size: 1.1rem; }
@media print {
  .header, .sidebar, .footer, .no-print { display: none !important; }
  .page-wrapper { margin: 0 !important; padding: 0 !important; }
}
</style>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header no-print">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Receipt</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/fees-collections">Fees Collection</a></li>
<li class="breadcrumb-item active">Receipt</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<button onclick="window.print()" class="btn btn-primary"><i class="fas fa-print"></i> Print</button>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card">
<div class="card-body invoice-box">
<div class="invoice-header">
<img src="/img/logo.png" alt="Logo">
<div class="invoice-title">
<h2>Receipt</h2>
<div class="invoice-meta">#FC-<%= String(collection.id).padStart(5, '0') %></div>
</div>
</div>
<div class="invoice-parties">
<div>
<strong>Billed to</strong><br>
<%= collection.student.firstName %> <%= collection.student.lastName %><br>
Student ID: <%= collection.student.studentId %><br>
<% if (collection.student.classRef) { %>Class: <%= collection.student.classRef.name %> <%= collection.student.classRef.section %><br><% } %>
</div>
<div>
<strong>Payment Date</strong><br>
<%= collection.paidDate ? collection.paidDate.toDateString() : 'Not recorded' %>
</div>
</div>
<div class="table-responsive">
<table class="table table-bordered mb-0">
<thead>
<tr>
<th>Description</th>
<th class="text-right">Amount</th>
</tr>
</thead>
<tbody>
<tr>
<td><%= collection.feesType %></td>
<td class="text-right"><%= collection.amount.toFixed(2) %></td>
</tr>
<tr class="invoice-total-row">
<td>Total Paid</td>
<td class="text-right"><%= collection.amount.toFixed(2) %></td>
</tr>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
