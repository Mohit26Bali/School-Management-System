<%- include('../partials/head', { title, extraCss: ['/vendor/datatables/datatables.min.css'] }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Fees Collection</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Fees Collection</li>
</ul>
</div>
<div class="col-auto text-right float-right ml-auto">
<a href="/fees-collections/add" class="btn btn-primary"><i class="fas fa-plus"></i> Add Collection</a>
</div>
</div>
</div>
<div class="row">
<div class="col-sm-12">
<div class="card card-table">
<div class="card-body">
<div class="table-responsive">
<table class="table table-hover table-center mb-0 datatable">
<thead>
<tr>
<th>ID</th>
<th>Name</th>
<th>Gender</th>
<th>Fees Type</th>
<th>Amount</th>
<th>Paid Date</th>
<th class="text-right">Action</th>
</tr>
</thead>
<tbody>
<% if (collections.length === 0) { %>
<tr><td colspan="7" class="text-center text-muted">No fee payments yet. <a href="/fees-collections/add">Add the first one</a>.</td></tr>
<% } %>
<% collections.forEach(function(c) { %>
<tr>
<td><%= c.student.studentId %></td>
<td><a href="/students/<%= c.student.id %>"><%= c.student.firstName %> <%= c.student.lastName %></a></td>
<td><%= c.student.gender || '-' %></td>
<td><%= c.feesType %></td>
<td><%= c.amount.toFixed(2) %></td>
<td><%= c.paidDate ? c.paidDate.toDateString() : '-' %></td>
<td class="text-right">
<div class="actions">
<a href="/fees-collections/<%= c.id %>/invoice" class="btn btn-sm bg-info-light mr-2" title="Print Receipt">
<i class="fas fa-file-invoice"></i>
</a>
<a href="/fees-collections/<%= c.id %>/edit" class="btn btn-sm bg-success-light mr-2">
<i class="fas fa-pen"></i>
</a>
<form method="POST" action="/fees-collections/<%= c.id %>/delete" class="d-inline" onsubmit="return confirm('Delete this payment record?');">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button type="submit" class="btn btn-sm bg-danger-light">
<i class="fas fa-trash"></i>
</button>
</form>
</div>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
</div>
</div>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts', { extraScripts: ['/vendor/datatables/datatables.min.js'] }) %>
</body>
</html>
