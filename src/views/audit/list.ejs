<%- include('../partials/head', { title }) %>
<body>
<div class="main-wrapper">
<%- include('../partials/header', { user: sessionUser }) %>
<%- include('../partials/sidebar', { currentPage }) %>
<div class="page-wrapper">
<div class="content container-fluid">
<div class="page-header">
<div class="row align-items-center">
<div class="col">
<h3 class="page-title">Audit Log</h3>
<ul class="breadcrumb">
<li class="breadcrumb-item"><a href="/">Dashboard</a></li>
<li class="breadcrumb-item active">Audit Log</li>
</ul>
</div>
</div>
</div>
<ul class="nav nav-pills mb-3">
<li class="nav-item"><a class="nav-link <%= entity === '' ? 'active' : '' %>" href="/audit">All</a></li>
<% Object.keys(entities).forEach(function(key) { %>
<li class="nav-item"><a class="nav-link <%= entity === key ? 'active' : '' %>" href="/audit?entity=<%= key %>"><%= entities[key] %></a></li>
<% }) %>
</ul>
<div class="card card-table">
<div class="card-body">
<p class="text-muted">Every change to a fee payment, expense or salary, and who made it. <%= total %> entries.</p>
<div class="table-responsive">
<table class="table table-hover mb-0">
<thead>
<tr><th>When</th><th>Who</th><th>Action</th><th>Record</th><th>Details</th></tr>
</thead>
<tbody>
<% if (entries.length === 0) { %>
<tr><td colspan="5" class="text-center text-muted">Nothing recorded yet.</td></tr>
<% } %>
<% entries.forEach(function(e) { %>
<tr>
<td><%= e.createdAt.toLocaleString('en-GB') %></td>
<td><%= e.userName || 'unknown' %></td>
<td><span class="badge badge-<%= e.action === 'delete' ? 'danger' : e.action === 'create' ? 'success' : 'info' %>"><%= e.action %></span></td>
<td><%= entities[e.entity] || e.entity %> #<%= e.entityId %></td>
<td>
<% if (e.action === 'update') { %>
<% Object.keys(e.changes).forEach(function(field) { %>
<div><strong><%= field %></strong>: <%= e.changes[field][0] === null ? '(empty)' : e.changes[field][0] %> &rarr; <%= e.changes[field][1] === null ? '(empty)' : e.changes[field][1] %></div>
<% }) %>
<% } else { %>
<% Object.keys(e.changes).filter(function(k) { return k !== 'id' && e.changes[k] !== null && k !== 'createdAt'; }).forEach(function(field) { %>
<span class="mr-2"><strong><%= field %></strong>: <%= e.changes[field] %></span>
<% }) %>
<% } %>
</td>
</tr>
<% }) %>
</tbody>
</table>
</div>
<% if (pages > 1) { %>
<nav class="mt-3">
<% if (page > 1) { %><a class="btn btn-sm btn-outline-primary" href="/audit?<%= entity ? 'entity=' + entity + '&' : '' %>page=<%= page - 1 %>">&laquo; Newer</a><% } %>
<span class="mx-2">Page <%= page %> of <%= pages %></span>
<% if (page < pages) { %><a class="btn btn-sm btn-outline-primary" href="/audit?<%= entity ? 'entity=' + entity + '&' : '' %>page=<%= page + 1 %>">Older &raquo;</a><% } %>
</nav>
<% } %>
</div>
</div>
</div>
<%- include('../partials/footer') %>
</div>
</div>
<%- include('../partials/scripts') %>
</body>
</html>
